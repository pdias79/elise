REM  *****  BASIC  *****

' RGB : Unités = bleu vert rouge
const Jaune_fonce = 13937152 'RGB(212, 170, 0)     'D4AA00
const Jaune_clair   = 16763904  'RGB(255, 204, 0)  'FFCC00
const Jaune=Jaune_clair

 'RGB(0,128,128)


const Vert=4499968 ' RGB(68, 170, 0) '44AA00
const Rose=16711935 ' RGB(255,0,255) 'FF00FF
const Noir=0 ' RGB(0,0,0)             
const Rouge=13121335' RGB(200,55,55) 'C83737
const Bleu=52171' RGB(0, 203, 203)   '00CBCB


Sub EncadrementTexte(Optional couleur)
    Dim oDoc As Object
    Dim oSel As Object
    Dim oCursor As Object
    Dim oBorder As New com.sun.star.table.BorderLine2
    
    If IsMissing(couleur) Then
        _Width = 0 ' Voici votre valeur par défaut
        couleur = -1
        padding = 0
    Else
        _Width = 20 
        padding = 50
    End If    

   ' oDoc = ThisComponent
    'oSel = oDoc.CurrentSelection(0)
        oDoc = ThisComponent
    oSel = oDoc.CurrentController.Selection
    If not oSel.supportsService("com.sun.star.text.TextRanges") Then
      exit sub
    end if  
     oCursor = oSel.getByIndex(0)
        
    ' On crée un curseur sur la sélection pour accéder aux propriétés de paragraphe
    'oCursor = oDoc.Text.createTextCursorByRange(oSel)

    ' On définit une bordure "vide" (largeur à 0)
    oBorder.Color = couleur
    oBorder.LineWidth = _Width
    oBorder.OuterLineWidth =_Width

    ' On applique cette bordure vide aux 4 côtés du paragraphe
    oCursor.CharTopBorder = oBorder
    oCursor.CharBottomBorder = oBorder
    oCursor.CharLeftBorder = oBorder
    oCursor.CharRightBorder = oBorder

    ' Optionnel : Ajouter un peu d'espace (padding) entre le texte et le cadre
    oCursor.CharTopBorderDistance = padding
    oCursor.CharBottomBorderDistance =padding
    
End Sub

Sub SupprimerEncadrementTexte
    EncadrementTexte()
End Sub

Sub EncadrerTexteEnRouge
    EncadrementTexte(Couleur:=Rouge)
End Sub

Sub EncadrerTexteEnVert
    EncadrementTexte(Couleur:=Vert)
End Sub

Sub EncadrerTexteEnBleu
    EncadrementTexte(Couleur:=Bleu)
End Sub

Sub EncadrerTexteEnJaune
    EncadrementTexte(Couleur:=Jaune)
End Sub

Sub EncadrerTexteEnRose
    EncadrementTexte(Couleur:=Rose)
End Sub

Sub EncadrerTexteEnNoir
    EncadrementTexte(Couleur:=Noir)
End Sub


Sub SoulignerTexte(optional couleur)
    Dim oDoc As Object
    Dim oSelection As Object
    Dim oCursor As Object
    Dim i As Integer

    ' Accéder au document actuel
    oDoc = ThisComponent
    
    ' Récupérer la sélection de l'utilisateur
    oSelection = oDoc.getCurrentSelection()

    ' Vérifier s'il y a bien une sélection
    If Not IsNull(oSelection) Then
        For i = 0 To oSelection.getCount() - 1
            oCursor = oSelection.getByIndex(i)
            
            If IsMissing(couleur) Then
                ' On désactive le soulignement (NONE)
                oCursor.CharUnderline = com.sun.star.awt.FontUnderline.NONE
                oCursor.CharUnderlineHasColor = False
            
                ' On remet la couleur de soulignement par défaut (Automatique)
                oCursor.CharUnderlineColor = -1
            else
            
                ' Appliquer le style de soulignement (Simple)
                oCursor.CharUnderline = com.sun.star.awt.FontUnderline.SINGLE
                oCursor.CharUnderlineHasColor = True
            
                ' Définir la couleur du soulignement en Rouge (Format RGB)
                ' La valeur 16711680 correspond au rouge pur
                oCursor.CharUnderlineColor = couleur
            End If
        Next i
    End If
End Sub


Sub SupprimerSoulignementTexte
    SoulignerTexte()
End Sub

Sub SoulignerTexteEnRouge
    SoulignerTexte(Couleur:=Rouge)
End Sub

Sub SoulignerTexteEnVert
    SoulignerTexte(Couleur:=Vert)
End Sub

Sub SoulignerTexteEnBleu
    SoulignerTexte(Couleur:=Bleu)
End Sub

Sub SoulignerTexteEnJaune
    SoulignerTexte(Couleur:=Jaune)
End Sub

Sub SoulignerTexteEnRose
    SoulignerTexte(Couleur:=Rose)
End Sub

Sub SoulignerTexteEnNoir
    SoulignerTexte(Couleur:=Noir)
End Sub



Sub SurlignerTexte(optional couleur)
    Dim oDoc As Object
    Dim oSelection As Object
    Dim oCursor As Object
    Dim i As Integer

    oDoc = ThisComponent
    oSelection = oDoc.getCurrentSelection()

    If Not IsNull(oSelection) Then
        For i = 0 To oSelection.getCount() - 1
            oCursor = oSelection.getByIndex(i)

            If IsMissing(couleur) Then
                ' Appliquer la couleur de mise en évidence (Surlignage)
                ' -1 : Défaut = rien
                oCursor.CharBackColor = -1
            
                ' Optionnel : Passer le texte en blanc pour la lisibilité
                'oCursor.CharColor = RGB(255, 255, 255)
            else
                ' Appliquer la couleur de mise en évidence (Surlignage)
                oCursor.CharBackColor = couleur
            
                ' Optionnel : Passer le texte en blanc pour la lisibilité
                'oCursor.CharColor = RGB(255, 255, 255)
            End If            
        Next i
    End If
End Sub


Sub SupprimerSurlignageTexte
    SurlignerTexte()
End Sub

Sub SurlignerTexteEnRouge
    SurlignerTexte(Couleur:=Rouge)
End Sub

Sub SurlignerTexteEnVert
    SurlignerTexte(Couleur:=Vert)
End Sub

Sub SurlignerTexteEnBleu
    SurlignerTexte(Couleur:=Bleu)
