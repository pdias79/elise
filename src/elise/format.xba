End Sub



Sub InsererDateCours
    Dim oDoc As Object
    Dim oText As Object
    Dim oCursor As Object
    
    oDoc = ThisComponent
    oText = oDoc.Text
    ' On récupère la position actuelle du curseur
    oCursor = oDoc.CurrentController.getViewCursor()

    ' 1. On définit le formatage en italique
    oCursor.CharPosture = com.sun.star.awt.FontSlant.ITALIC
    
    ' 2. On génère la date (le format "nnnn" donne le jour, "d mmmm yyyy" le reste)
    ' Note : Le système utilisera la date actuelle de l'ordinateur
    Dim dateStr As String
    dateStr = Format(Now, "nnnn d mmmm yyyy")
    
    ' 3. On insère la date et deux retours à la ligne
    oText.insertString(oCursor, dateStr & Chr(13) & Chr(13), False)
    
    ' 4. On enlève l'italique pour la suite du cours
    oCursor.CharPosture = com.sun.star.awt.FontSlant.NONE
    
End Sub





Sub SupprimerFormatage
  SupprimerEncadrementTexte
  SupprimerSoulignementTexte
  SupprimerSurlignageTexte
  ChangerCouleurTexte(Couleur:=Noir)
End Sub
 
 
 
 Sub ToggleVerificationLinguistique_old(optional status) 
    Dim oLinguServiceManager As Object
    Dim oLinguProps As Object
    Dim bState As Boolean

    ' Accéder aux propriétés du service linguistique
    oLinguServiceManager = createUnoService("com.sun.star.linguistic2.LinguServiceManager")
    oLinguProps = createUnoService("com.sun.star.linguistic2.LinguProperties")

    ' Récupérer l'état actuel de la vérification automatique
    If IsMissing(couleur) Then
        status = not oLinguProps.IsSpellAuto
    end if    
    
    ' Inverser l'état (Toggle)
    If status = False Then
        oLinguProps.IsSpellAuto = False        ' Désactiver l'orthographe
'        oLinguProps.IsGrammarAuto = False      ' Désactiver la grammaire
        'MsgBox "Vérification désactivée", 64, "Linguistique"
    Else
        oLinguProps.IsSpellAuto = True         ' Activer l'orthographe
        'oLinguProps.IsGrammarAuto = True       ' Activer la grammaire
        'MsgBox "Vérification activée", 64, "Linguistique"
    End If
    ThisComponent.reformat()
End Sub


Sub ToggleVerificationLinguistique(optional status) 
    Dim oLinguProps As Object
    
    ' Accéder au service des propriétés linguistiques
    oLinguProps = createUnoService("com.sun.star.linguistic2.LinguProperties")

    ' 1. Activer l'orthographe automatique
    oLinguProps.setPropertyValue("IsSpellAuto", status)
    
    ' 2. Activer la grammaire automatique (avec gestion d'erreur sécurisée)
    On Error Resume Next
    oLinguProps.setPropertyValue("IsGrammarAuto", status)
    On Error GoTo 0
    
    ' Petit retour visuel dans la barre d'état
    'ThisComponent.CurrentController.StatusIndicator.start("Correction activée", 1)
    'Wait 1000
    'ThisComponent.CurrentController.StatusIndicator.end()
    ThisComponent.reformat()
End Sub





Sub ActiverVerificationLinguistique
    ToggleVerificationLinguistique_old(True)
end sub
    
Sub DesactiverVerificationLinguistique
    ToggleVerificationLinguistique_old(False)
end sub 



Sub ChangerCouleurTexte(optional couleur)
    Dim oDoc As Object
    Dim oSelection As Object
    Dim oCursor As Object
    Dim i As Integer

    oDoc = ThisComponent
    oSelection = oDoc.getCurrentSelection()

    If Not IsNull(oSelection) Then
        For i = 0 To oSelection.getCount() - 1
            oCursor = oSelection.getByIndex(i)

            If IsMissing(couleur) Then
                ' Appliquer la couleur de mise en évidence (Surlignage)
                ' -1 => Défaut = rien
                oCursor.CharColor = -1
            else
                ' Appliquer la couleur de mise en évidence (Surlignage)
                oCursor.CharColor = couleur

            End If            
        Next i
    End If
End Sub


Sub ChangerCouleurTexteEnNoir
    ChangerCouleurTexte(Couleur:=Noir)
End Sub

Sub ChangerCouleurTexteEnRouge
