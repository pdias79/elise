<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons"
                    oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">



      <!-- ═══════════════════════════════════════════════════════
          1. Déclaration de la barre d'outils
              (visible dans Affichage > Barres d'outils)

          IMPORTANT = L'ordre est respecté si name est un numérique pur
          ═══════════════════════════════════════════════════════ -->
    <node oor:name="OfficeToolBar">
      <node oor:name="com.pdias80.elise.toolbar" oor:op="replace">
        <!-- NOM AFFICHÉ DANS L'INTERFACE LIBREOFFICE -->
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="fr">La Barre d'Outils pour Elise</value>
        </prop>

        <node oor:name="01" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>macro:///elise.format.EncadrerTexteEnRouge</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="fr">Encadrer en rouge</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        </node>

        <node oor:name="02" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>macro:///elise.format.EncadrerTexteEnVert</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="fr">Encadrer en vert</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        </node>

        <node oor:name="03" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string"><value>macro:///elise.format.EncadrerTexteEnBleu</value></prop>
          <prop oor:name="Title" oor:type="xs:string"><value xml:lang="fr">Encadrer en bleu</value></prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
          <prop oor:name="Context" oor:type="xs:string"><value>com.sun.star.text.TextDocument</value></prop>
        </node>

                
        <node oor:name="04" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
              <value>.uno:Separator</value>
          </prop>
        </node>

        <!-- Exemple d'ajout d'une commande intégrée de LibreOffice -->

        <node oor:name="05" oor:op="replace">
          <prop oor:name="URL" oor:type="xs:string">
            <value>.uno:SpellOnline</value>
          </prop>
          <prop oor:name="Title" oor:type="xs:string">
            <value>Vérification orthographique automatique</value>
          </prop>
          <prop oor:name="Target" oor:type="xs:string"><value>_self</value></prop>
        </node>

        
      </node>
    </node>

    <!-- ═══════════════════════════════════════════════════════
          2. Menu (conservé)
          ═══════════════════════════════════════════════════════ -->
    <node oor:name="OfficeMenuBar">
      <node oor:name="com.pdias80.elise.menu" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="fr">Mon Extension 01</value>
        </prop>
        <node oor:name="Submenu">
          <node oor:name="m01" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string">
              <value>macro:///MonExtensionPourElise.PourElise.Macro01</value>
            </prop>
            <prop oor:name="Title" oor:type="xs:string">
              <value xml:lang="fr">Action 01</value>
            </prop>
          </node>
        </node>
      </node>
    </node>

    <node oor:name="Images">

      <node oor:name="i01_EncadrerTexteEnRouge" oor:op="replace">
        <prop oor:name="URL"><value>macro:///elise.format.EncadrerTexteEnRouge</value></prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL"><value>%origin%/icons/Encadrer_Rouge.png</value></prop>
          <prop oor:name="ImageBigURL"><value>%origin%/icons/Encadrer_Rouge.png</value></prop>
        </node>
      </node>

      <node oor:name="i02_EncadrerTexteEnVert" oor:op="replace">
        <prop oor:name="URL"><value>macro:///elise.format.EncadrerTexteEnVert</value></prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL"><value>%origin%/icons/Encadrer_Vert.png</value></prop>
          <prop oor:name="ImageBigURL"><value>%origin%/icons/Encadrer_Vert.png</value></prop>
        </node>
      </node>

      <node oor:name="i03_EncadrerTexteEnBleu" oor:op="replace">
        <prop oor:name="URL"><value>macro:///elise.format.EncadrerTexteEnBleu</value></prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL"><value>%origin%/icons/Encadrer_Bleu.png</value></prop>
          <prop oor:name="ImageBigURL"><value>%origin%/icons/Encadrer_Bleu.png</value></prop>
        </node>
      </node>

    </node>

  </node>
</oor:component-data>
