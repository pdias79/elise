<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Images"
                    oor:package="org.openoffice.Office">
  <node oor:name="UserInterface">
    <node oor:name="Images">

      <node oor:name="m01_EncadrerTexteEnRouge" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>macro:///elise.format.EncadrerTexteEnRouge</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>%origin%/icons/Encadrer_Rouge.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>%origin%/icons/Encadrer_Rouge.png</value>
          </prop>
        </node>
      </node>

      <node oor:name="m02_EncadrerTexteEnVert" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>macro:///elise.format.EncadrerTexteEnVert</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>%origin%/icons/Encadrer_Vert.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>%origin%/icons/Encadrer_Vert.png</value>
          </prop>
        </node>
      </node>

      <node oor:name="m03_EncadrerTexteEnBleu" oor:op="replace">
        <prop oor:name="URL" oor:type="xs:string">
          <value>macro:///elise.format.EncadrerTexteEnBleu</value>
        </prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL" oor:type="xs:string">
            <value>%origin%/icons/Encadrer_Bleu.png</value>
          </prop>
          <prop oor:name="ImageBigURL" oor:type="xs:string">
            <value>%origin%/icons/Encadrer_Bleu.png</value>
          </prop>
        </node>
      </node>

    </node>
  </node>
</oor:component-data>