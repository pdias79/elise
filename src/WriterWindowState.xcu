<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="WriterWindowState"
                    oor:package="org.openoffice.Office.UI">
  <node oor:name="UIElements">
    <node oor:name="States">

      <node oor:name="private:resource/toolbar/addon_com.pdias80.elise.toolbar"
            oor:op="replace">

        <!-- Titre affiché dans Affichage > Barres d'outils -->
        <prop oor:name="UIName" oor:type="xs:string">
          <value>Toolbar Elise</value>
        </prop>

        <!-- Ancrage automatique sur la première ligne de toolbars -->
        <prop oor:name="Docked" oor:type="xs:boolean">
          <value>true</value>
        </prop>
        <prop oor:name="DockingArea" oor:type="xs:int">
          <value>0</value>  <!-- 0 = haut, 1 = bas, 2 = gauche, 3 = droite -->
        </prop>
        <prop oor:name="DockPos" oor:type="xs:string">
          <value>0,2</value>  <!-- ligne,position -->
        </prop>

      </node>

    </node>
  </node>
</oor:component-data>
